{
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "lineWidth": 80
    }
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        "useJsonImportAttributes": "error",
        "useUniqueElementIds": "off"
      }
    }
  },
  "extends": [
    "ultracite"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json"
}
